# ─── Base de datos ───
# DEV: SQLite (ejecutable sin dependencias externas)
DATABASE_URL="file:./dev.db"
# PROD: Aurora PostgreSQL
# DATABASE_URL="postgresql://user:password@host:5432/agro360?schema=public"

# ─── Autenticación ───
# AUTH_MODE=local  → JWT local (demo/dev)
# AUTH_MODE=cognito → Amazon Cognito (prod). Ver docs/03-architecture.md
AUTH_MODE=local
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="12h"

# Cognito (solo si AUTH_MODE=cognito)
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
AWS_REGION="us-east-1"

# ─── IA (Amazon Bedrock) ───
# AI_MODE=rules → copiloto basado en reglas (dev, sin costos ni red)
# AI_MODE=bedrock → Amazon Bedrock (prod)
AI_MODE=rules
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet"
BEDROCK_KNOWLEDGE_BASE_ID=""

# ─── App ───
PORT=3000
NODE_ENV=development
